FROM golang:1.27.3-bookworm@sha256:972b4110ba0f47539a975c31e52c64765e1ff19f2d74469ae4a595c6676e80a5 AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -o /out/hub ./cmd/hub

FROM debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8
WORKDIR /app
COPY --from=builder --chown=10001:10001 /out/hub /app/hub
COPY --chown=10001:10001 config.example.yaml /app/config.yaml
COPY --chown=10001:10001 configs/sqlite.dev.yaml /app/config.sqlite.yaml
COPY --chown=10001:10001 configs/auth.dev.yaml /app/config.auth.yaml
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/app/hub"]
CMD ["--config", "/app/config.yaml"]
HEALTHCHECK --interval=3s --timeout=3s --start-period=5s --retries=3 CMD ["/app/hub", "--healthcheck", "http://127.0.0.1:8080/ready"]
