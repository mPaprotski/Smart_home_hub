# Export intentionally; the application does NOT auto-load .env.
HUB_PROFILE=development
HUB_ADAPTER_MODE=simulation
HUB_STORAGE=memory_fake
HUB_SERVER_HOST=127.0.0.1
HUB_SERVER_PORT=8080
# Disabled components do not require tokens. Never use fixed production secrets.
# SESSION_SECRET=
# ML_SERVICE_TOKEN=
# MQTT_PASSWORD=
# HUB_CONTAINER_NETWORK=true is for explicit private-container networking only.
# Only for explicit storage: sqlite; parent data directory must be private.
# HUB_DB_PATH=.runtime/data/hub.db
